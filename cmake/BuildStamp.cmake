# Writes a header that says exactly which source a build was made from. Run at build time (so it is never stale):
#   cmake -DSOURCE_DIR=<repo> -DOUT=<header> -P cmake/BuildStamp.cmake
# It reports the base commit, and whether the working tree is that exact commit or has uncommitted changes on top of it. The uncommitted case gets a short fingerprint of
# the changes (tracked-file diff against HEAD plus the contents of untracked source files), so two machines can check that they built the same working tree, and the output
# never claims that uncommitted changes are part of the commit. Only Source, Tests, Assets, cmake, docs and CMakeLists.txt are looked at (build folders are ignored).
execute_process(COMMAND git -C "${SOURCE_DIR}" rev-parse --short=9 HEAD RESULT_VARIABLE rc OUTPUT_VARIABLE base OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
if(NOT rc EQUAL 0 OR base STREQUAL "")
    set(base "unknown")
    set(state "no git information (not a git checkout)")
else()
    execute_process(COMMAND git -C "${SOURCE_DIR}" diff HEAD -- Source Tests Assets cmake docs CMakeLists.txt CHANGELOG.md OUTPUT_VARIABLE diffText ERROR_QUIET)
    execute_process(COMMAND git -C "${SOURCE_DIR}" ls-files --others --exclude-standard -- Source Tests Assets cmake docs CMakeLists.txt OUTPUT_VARIABLE untracked OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    set(material "${diffText}")
    if(untracked)
        string(REPLACE "\n" ";" untrackedList "${untracked}")
        list(SORT untrackedList)
        foreach(f ${untrackedList})
            file(SHA256 "${SOURCE_DIR}/${f}" h)
            string(APPEND material "untracked ${f} ${h}\n")
        endforeach()
    endif()
    if(material STREQUAL "")
        set(state "clean: exactly that commit")
    else()
        string(SHA256 fp "${material}")
        string(SUBSTRING "${fp}" 0 12 fp)
        set(state "UNCOMMITTED changes on top of that commit, fingerprint ${fp}")
    endif()
endif()
set(content "// generated by cmake/BuildStamp.cmake at build time; do not edit\n#define GLITCHKID_BUILD_BASE \"${base}\"\n#define GLITCHKID_BUILD_TREE \"${state}\"\n")
set(existing "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" existing)
endif()
if(NOT existing STREQUAL content) # rewritten only when it changed, so nothing is recompiled for no reason
    get_filename_component(dir "${OUT}" DIRECTORY)
    file(MAKE_DIRECTORY "${dir}")
    file(WRITE "${OUT}" "${content}")
endif()
